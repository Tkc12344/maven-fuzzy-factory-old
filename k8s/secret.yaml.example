# Copy to secret.yaml and fill values, then:
#   kubectl apply -f k8s/secret.yaml
# Do not commit real keys.
apiVersion: v1
kind: Secret
metadata:
  name: mff-secrets
  namespace: maven-fuzzy-factory
type: Opaque
stringData:
  API_TOKEN: "change-me"
  MISTRAL_API_KEY: ""
  SERPAPI_KEY: ""
  GEMINI_API_KEY: ""
  OPENAI_API_KEY: ""
  SLACK_WEBHOOK_URL: ""
  TEAMS_WEBHOOK_URL: ""
  EMAIL_WEBHOOK_URL: ""
